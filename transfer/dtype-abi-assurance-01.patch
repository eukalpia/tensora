+    case MODE_RANK_ABOVE_LIMIT:
+      *out_rank = 65;
+      break;
+    case MODE_SCALAR_RANK_CHANGED:
+      *out_rank = 0;
+      break;
+    case MODE_RANK_CHANGED:
+      *out_rank = 2;
+      break;

+  final normalizedOverride = overridePath?.trim();
+  if (normalizedOverride != null && normalizedOverride.isNotEmpty) {
+    return normalizedOverride;
+  }
+  return switch (operatingSystem) {
+    'windows' => 'tensora_native.dll',
+    'macos' => 'libtensora_native.dylib',
+    'linux' => 'libtensora_native.so',
+    _ => throw UnsupportedOperationException(
+      'Unsupported operating system: $operatingSystem.',
+      operation: 'runtime.load',
+    ),
+  };
+}

+
+  test('training status mapping preserves typed failures', () {
+    final cases = <(int, Matcher)>[
+      (FaultMode.invalidHandle, isA<InvalidHandleException>()),
+      (FaultMode.unsupported, isA<UnsupportedOperationException>()),
+      (FaultMode.modelError, isA<ModelRuntimeException>()),
+      (
+        FaultMode.unknownStatus,
+        isA<NativeRuntimeException>().having(
+          (error) => error.message,
+          'message',
+          contains('Unknown native status 99'),
+        ),
+      ),
+    ];
+
+    for (final entry in cases) {
+      control.setMode(entry.$1);
+      expect(() => runtime.available(), throwsA(entry.$2));
+    }
+
+    control.setMode(FaultMode.nullDiagnostic);
+    expect(
+      () => runtime.available(),
+      throwsA(
+        isA<NativeRuntimeException>().having(
+          (error) => error.message,
+          'message',
+          contains('without a diagnostic'),
+        ),
+      ),
+    );
+  });
+
+  test('module and optimizer finalizer callbacks delegate release', () {
+    control.resetCounters();
+    releaseModuleFromFinalizer(81);
+    releaseOptimizerFromFinalizer(82);
+    expect(control.releaseCount, 2);
+  });
+
+  test('successful training creation must return non-zero handles', () {
+    control.setMode(FaultMode.nullTrainingHandle);
+    expect(
+      () => runtime.linearCreate(1, 1, true),
+      throwsA(
+        isA<NativeRuntimeException>()
+            .having((error) => error.operation, 'operation', 'linear.create')
+            .having(
+              (error) => error.message,
+              'message',
+              contains('null module handle'),
+            ),
+      ),
+    );
+    expect(
+      () => runtime.sgdCreate(
+        1,
+        learningRate: 0.1,
+        momentum: 0,
+        weightDecay: 0,
+      ),
+      throwsA(
+        isA<NativeRuntimeException>()
+            .having((error) => error.operation, 'operation', 'sgd.create')
+            .having(
+              (error) => error.message,
+              contains('null optimizer handle'),
+            ),
+      ),
+    );

+import 'dart:ffi';
+import 'dart:io';
+
+import 'package:ffi/ffi.dart';
+
+final class FaultMode {
+  static const int normal = 0;
+  static const int abiMismatch = 1;
+
+  static const int invalidArgument = 10;
+  static const int invalidShapeStatus = 11;
+  static const int outOfMemory = 12;
+  static const int unsupported = 13;
+  static const int invalidHandle = 14;
+  static const int internalError = 15;
+  static const int modelError = 16;
+  static const int unknownStatus = 17;
+  static const int nullDiagnostic = 18;
+
+  static const int nullTensorHandle = 20;
+  static const int rankAboveLimit = 21;
+  static const int scalarRankChanged = 22;
+  static const int rankChanged = 23;
+  static const int invalidShapeMetadata = 24;
+  static const int unknownDType = 25;
+  static const int invalidCpuIndex = 26;
+  static const int invalidCudaIndex = 27;
+  static const int invalidMpsIndex = 28;
+  static const int invalidXpuIndex = 29;
+  static const int invalidHipIndex = 30;
+  static const int unknownDevice = 31;
+  static const int inconsistentNumel = 32;
+  static const int validCudaTensor = 33;
+
+  static const int nullTrainingHandle = 40;
+  static const int acceleratorCounts = 41;
+  static const int moduleBuffer = 42;
+  static const int moduleAdoptionFailure = 43;
+
+  static const int nullSessionHandle = 50;
+  static const int providerMismatch = 51;
+  static const int noOutputs = 52;
+  static const int invalidUtf8Size = 53;
+  static const int changedUtf8Size = 54;
+  static const int outputCountMismatch = 55;
+  static const int outputAdoptionFailure = 56;
+
+  static const int dtypeFloat16 = 60;
+  static const int dtypeBFloat16 = 61;
+  static const int dtypeFloat64 = 62;
+  static const int dtypeInt8 = 63;
+  static const int dtypeUint8 = 64;
+  static const int dtypeInt16 = 65;
+  static const int dtypeInt32 = 66;
+  static const int dtypeInt64 = 67;
+  static const int dtypeBool = 68;
+}
+
+typedef _SetModeNative = Void Function(Int32);
+typedef _SetModeDart = void Function(int);
+typedef _ReleaseCountNative = Uint64 Function();
+typedef _ReleaseCountDart = int Function();
+typedef _ResetCountersNative = Void Function();
+typedef _ResetCountersDart = void Function();
+
+final class FaultRuntimeControl {
+  FaultRuntimeControl._(this._library)
+    : _setMode = _library
+          .lookup<NativeFunction<_SetModeNative>>('ts_test_set_mode')
